{
  "name": "zhishi-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "知时 · 考试与时钟平板应用（考试广播系统 / 桌面时钟 / 个人档案），纯本地存储，无后端。",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "gen:audio": "node scripts/generate-placeholder-audio.mjs",
    "assets": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-android-res.ps1",
    "build:portable": "vite build -c vite.dist.config.js",
    "android:sync": "cap sync android",
    "android:open": "cap open android"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "vue": "^3.5.13",
    "@capacitor/core": "^6.1.2",
    "@capacitor/android": "^6.1.2",
    "@capacitor/splash-screen": "^6.0.2",
    "@capacitor/status-bar": "^6.0.0",
    "@capacitor/filesystem": "^6.0.0",
    "@capacitor/share": "^6.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "vite": "^6.0.7",
    "@capacitor/cli": "^6.1.2",
    "typescript": "^5.6.3"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
